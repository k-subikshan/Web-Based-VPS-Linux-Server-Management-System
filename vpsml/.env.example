# Application
SERVER_PORT=8080

# MySQL
DB_URL=jdbc:mysql://localhost:3306/mydb2?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change_me
JPA_DDL_AUTO=update

# SSH
VPS_SSH_TIMEOUT=10000
VPS_COMMAND_TIMEOUT=30000
# no = easy development; yes = use a populated ~/.ssh/known_hosts
VPS_STRICT_HOST_KEY_CHECKING=no

# Database mode: h2 (default) or mysql
SPRING_PROFILES_ACTIVE=h2

# Only required when SPRING_PROFILES_ACTIVE=mysql
DB_URL=jdbc:mysql://localhost:3306/mydb2?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
